# 域名解析完成后填写，例如 api.xiaodouya.cn。不要带 https:// 或路径。
PUBLIC_API_DOMAIN=api.example.cn

# MySQL：自行生成至少 20 位的随机密码，且不要在 Git、截图或聊天记录中发送真实值。
MYSQL_DATABASE=xiaodouya
MYSQL_USERNAME=xiaodouya
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# 微信公众平台「开发管理 → 开发设置」中的同一小程序凭证。
WECHAT_APP_ID=wx_replace_me
WECHAT_APP_SECRET=replace-with-wechat-app-secret

# 阿里云百炼。二选一即可；项目会优先使用 BAILIAN_API_KEY。
BAILIAN_API_KEY=replace-with-bailian-api-key
BAILIAN_MODEL=qwen3.8-flash

# 备案完成后填写真实信息；未完成备案前可留空，只用于服务器联调。
APP_ICP_FILING_NO=
APP_OPERATOR_NAME=
APP_SERVICE_EMAIL=
APP_SERVICE_PHONE=
